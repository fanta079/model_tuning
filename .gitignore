# ---- 大文件: 模型 / 数据 / 训练产物 (不纳入版本控制) ----
models/
alpaca_zh/
outputs/
unsloth_compiled_cache/

# ---- 模型与数据文件兜底 (防止误放到其他目录) ----
*.safetensors
*.gguf
*.bin
*.pt
*.pth
*.ckpt
*.tar
*.vhdx
*.whl

# ---- 外挂记忆: 会积累个人内容, 不入库 (文件缺失时 memory.py 会自动重建模板) ----
memory.md

# ---- 个人训练数据: 会包含聊天记录等私人内容, 绝不入库 ----
my_data/
wechat_data/

# ---- 密钥: API key 等凭证绝不入库 (用环境变量传) ----
.env
.env*
*.key

# ---- 生成的音频样本 (随时可用 app/try_voices.py 重新生成) ----
app/voice_samples/

# ---- 工具与 IDE ----
.idea/
.vscode/
.workbuddy/

# ---- 系统垃圾 ----
Thumbs.db
.DS_Store
__pycache__/
*.pyc

# ---- 运行日志（含模型服务输出，不入库）----
logs/
artifacts/

# 自签证书（含私钥，绝不入库）
certs/
